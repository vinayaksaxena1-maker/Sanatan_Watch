<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_container_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="4dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp">
            
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ॐ सनातन घड़ी पंचांग"
                android:textColor="#FF9933"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Divider line -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FF9933"
            android:layout_marginBottom="8dp" />

        <!-- Tithi and Nakshatra Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="आज की तिथि"
                    android:textColor="#888888"
                    android:textSize="9sp" />
                
                <TextView
                    android:id="@+id/widget_tithi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="लोअडिंग..."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="8dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="आज का नक्षत्र"
                    android:textColor="#888888"
                    android:textSize="9sp" />
                
                <TextView
                    android:id="@+id/widget_nakshatra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="लोअडिंग..."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Choghadiya Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2E231D"
            android:padding="6dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/widget_choghadiya_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="सक्रिय चौघड़िया: —"
                android:textColor="#FFB74D"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_choghadiya_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="समय: —"
                android:textColor="#81C784"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rahu Kaal Warning Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#4A1515"
            android:padding="5dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ राहुकाल: "
                android:textColor="#FF8A80"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_rahu_kaal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
